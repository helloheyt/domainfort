# Rust
/target
**/*.rs.bk
# The workspace Cargo.lock IS tracked (D183): since external dependencies came in
# (RustCrypto, krb-crypto) it pins exact versions — for a reproducible build (D61) and the supply
# chain (R13). Only the Cargo.lock of detached workspaces (fuzz) stays untracked.
# (The comment must be on its own line; an inline comment breaks the pattern in .gitignore.)
crates/*/fuzz/Cargo.lock


# Working directories of tests that read through protected-file (crates/test-scratch; Q-480)
/.test-scratch/
# Working directories of the tier-3 tests run as root (owned by root, 0755; crates/test-scratch `ScratchDir::new_tier3`; Q-680)
/.test-scratch-tier3/

# Specification library — downloaded files are kept locally; the manifest (with the sha256) IS tracked.
/tools/spec-pin/cache/

# SBOM output (generated in CI or locally; not tracked)
*.cdx.json
bom.json

# System
.DS_Store
